# Start MySQL in XAMPP and create this database with database/setup.sql.
DB_NAME=nexora_app
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_DEBUG=1

# AI defaults; also configurable through the admin dashboard
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Stytch B2B email verification for signup and password reset.
EMAIL_OTP_BACKEND=stytch
STYTCH_PROJECT_ID=
STYTCH_SECRET=
STYTCH_ENV=test
STYTCH_ORGANIZATION_ID=

# For local demonstrations without email, explicitly set EMAIL_OTP_BACKEND=dev
# with DJANGO_DEBUG=1. Stytch test mode still sends codes through Stytch.

NO_PROXY=*
PYTHONIOENCODING=utf-8
